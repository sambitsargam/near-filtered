# Copy to .env and fill in. .env is gitignored and must never be committed.
# None of these are needed for `make rebuild` or `make verify` — those run
# entirely from the committed aggregates in data/cache/. They are needed only
# for `make refresh`, which re-pulls live data.

# --- Google Cloud / BigQuery ---------------------------------------------
# Billing project used to run queries against the public NEAR dataset.
# The dataset itself is public; you pay only for bytes your queries scan.
GCP_PROJECT_ID=your-gcp-project-id

# Hard ceiling on bytes billed per query. The pipeline refuses to run a query
# whose dry-run estimate exceeds this. 50 GB ~= $0.31 at $6.25/TiB (US).
MAX_BYTES_BILLED=53687091200

# Optional: path to a service-account key. Leave empty to use Application
# Default Credentials from `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# --- NEAR Intents Explorer API -------------------------------------------
# JWT from https://partners.near-intents.org/
# Rate limit: 1 request / 5 s / partner. The client enforces this.
INTENTS_JWT=your-intents-jwt

# --- Price data (optional) ------------------------------------------------
# CoinGecko demo key: https://www.coingecko.com/en/api
# Leave empty to use the keyless public endpoint (lower rate limit).
COINGECKO_API_KEY=
